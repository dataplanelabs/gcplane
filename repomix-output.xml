	m := &Metrics{}
	done := make(chan struct{})

	go func() {
		for {
			select {
			case <-done:
				return
			default:
				m.mu.Lock()
				m.SyncSuccess++
				m.mu.Unlock()
			}
		}
	}()

	for i := 0; i < 100; i++ {
		_ = m.Snapshot()
	}
	close(done)
}
