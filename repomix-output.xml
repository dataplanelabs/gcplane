		{"api key", "apiKey", "api_key"},
		{"api base", "apiBase", "api_base"},
		{"provider type", "providerType", "provider_type"},
		{"is default", "isDefault", "is_default"},
		{"agent type", "agentType", "agent_type"},
		{"tools config", "toolsConfig", "tools_config"},
