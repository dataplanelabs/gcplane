	tests := []struct {
		code    int
		wantErr error
	}{
		{200, nil},
		{201, nil},
		{204, nil},
		{400, ErrInvalidRequest},
		{401, ErrUnauthorized},
		{403, ErrUnauthorized},
		{404, ErrNotFound},
		{422, ErrInvalidRequest},
		{500, ErrServerError},
		{503, ErrServerError},
	}

	for _, tc := range tests {
		err := classifyStatus(tc.code, []byte("body"))
		if tc.wantErr == nil {
			if err != nil {
				t.Errorf("status %d: expected nil, got %v", tc.code, err)
