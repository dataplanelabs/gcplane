	payload, err := c.Call(context.Background(), "test.method", nil)
	if err != nil {
		t.Fatalf("Call: %v", err)
	}
	var result map[string]any
	json.Unmarshal(payload, &result)
	if result["done"] != true {
		t.Errorf("expected done=true, got %v", result["done"])
	}
}

