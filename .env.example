# GoClaw connection (gateway token from goclaw .env)
GOCLAW_TOKEN=

# Multi-tenant (optional, GoClaw v1.2.0+)
# GOCLAW_TENANT_ID=acme-corp
# GOCLAW_USER_ID=your-owner-id           # must match GOCLAW_OWNER_IDS for tenant CRUD

# Z.ai Coding provider
GOCLAW_ZAI_CODING_API_KEY=

# OpenAI provider
GOCLAW_OPENAI_API_KEY=

# Alibaba DashScope provider (Qwen models)
GOCLAW_DASHSCOPE_API_KEY=

# Drift notification webhook (slack, discord, googlechat, teams, telegram)
GCPLANE_WEBHOOK_URL=
GCPLANE_WEBHOOK_FORMAT=slack

# Structured logging (text or json)
GCPLANE_LOG_FORMAT=text
